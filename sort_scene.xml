<mujoco model="stretch_sort">
  <include file="stretch.xml"/>
  <size memory="50M"/>

  <statistic center="2.5 -0.4 0.4" extent="6" meansize="0.08"/>
  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="60" elevation="-22"/>
  </visual>

  <asset>
    <material name="floor"     rgba=".10 .10 .10 1" reflectance="0.15"/>
    <texture type="2d" name="wood" file="wood.png"/>
    <material name="wood"      texture="wood"/>
    <material name="belt"      rgba=".22 .22 .24 1"/>
    <material name="belt_dark" rgba=".13 .13 .15 1"/>
    <material name="stripe"    rgba=".90 .85 .10 1"/>
    <material name="cube_red"  rgba=".90 .08 .08 1"/>
    <material name="cube_blue" rgba=".10 .25 .90 1"/>
    <material name="box_red"   rgba=".80 .06 .06 1"/>
    <material name="box_blue"  rgba=".06 .15 .80 1"/>
    <material name="path_mark" rgba=".22 .22 .25 1"/>
    <material name="home_mark" rgba=".90 .85 .10 1"/>
  </asset>

  <worldbody>
    <light pos="3 0 6" dir="0 0 -1" directional="true"  diffuse="0.8 0.8 0.8"/>
    <light pos="0 0 4" dir="0 0 -1" directional="false" diffuse="0.3 0.3 0.3"/>

    <geom name="floor" size="0 0 0.05" type="plane" material="floor"/>

    <!-- Home marker -->
    <geom type="box" pos="0 0 0.001" size="0.02 0.18 0.001"
          material="home_mark" contype="0" conaffinity="0"/>
    <geom type="box" pos="1 0 0.001" size=".05 .05 .001" material="path_mark" contype="0" conaffinity="0"/>
    <geom type="box" pos="2 0 0.001" size=".05 .05 .001" material="path_mark" contype="0" conaffinity="0"/>
    <geom type="box" pos="3 0 0.001" size=".05 .05 .001" material="path_mark" contype="0" conaffinity="0"/>

    <!--
      DEPOT BOXES — bottoms sit directly on the floor (no hovering)
      Floor geom centred at Z=0.02 (half-thickness 0.02 → spans Z=[0, 0.04])
      Walls centred at Z=0.16 (half-height 0.12 → spans Z=[0.04, 0.28])
      Box wall top = Z=0.28
    -->
    <body name="box_red" pos="1.0 -0.85 0">
      <geom type="box" size=".22 .22 .02" pos="0 0 .02"   material="box_red"/>
      <geom type="box" size=".22 .02 .16" pos="0  .24 .20" material="box_red"/>
      <geom type="box" size=".22 .02 .16" pos="0 -.24 .20" material="box_red"/>
      <geom type="box" size=".02 .24 .16" pos="-.24 0 .20" material="box_red"/>
      <geom type="box" size=".02 .24 .16" pos=" .24 0 .20" material="box_red"/>
    </body>

    <body name="box_blue" pos="2.0 -0.85 0">
      <geom type="box" size=".22 .22 .02" pos="0 0 .02"   material="box_blue"/>
      <geom type="box" size=".22 .02 .16" pos="0  .24 .20" material="box_blue"/>
      <geom type="box" size=".22 .02 .16" pos="0 -.24 .20" material="box_blue"/>
      <geom type="box" size=".02 .24 .16" pos="-.24 0 .20" material="box_blue"/>
      <geom type="box" size=".02 .24 .16" pos=" .24 0 .20" material="box_blue"/>
    </body>

    <!--
      CONVEYOR BELT  (flat, low profile, no walls)
      Top surface at Z = 0.27 + 0.27 = 0.54
    -->
    <body name="conveyor" pos="4.0 -0.85 0.27">
      <geom type="box" size=".75 .25 .27" mass="200" material="belt"/>
      <geom type="box" size=".72 .22 .005" pos="0 0 .275"
            material="belt_dark" contype="0" conaffinity="0"/>
      <geom type="box" size=".70 .015 .001" pos="0 -0.12 .281"
            material="stripe" contype="0" conaffinity="0"/>
      <geom type="box" size=".70 .015 .001" pos="0  0.00 .281"
            material="stripe" contype="0" conaffinity="0"/>
      <geom type="box" size=".70 .015 .001" pos="0  0.12 .281"
            material="stripe" contype="0" conaffinity="0"/>
      <geom type="box" size=".75 .010 .005" pos="0  .26 .281"
            material="stripe" contype="0" conaffinity="0"/>
      <geom type="box" size=".75 .010 .005" pos="0 -.26 .281"
            material="stripe" contype="0" conaffinity="0"/>
      <geom type="cylinder" size=".035 .27" pos=" .70  .20 -.27" rgba=".24 .24 .27 1"/>
      <geom type="cylinder" size=".035 .27" pos="-.70  .20 -.27" rgba=".24 .24 .27 1"/>
      <geom type="cylinder" size=".035 .27" pos=" .70 -.20 -.27" rgba=".24 .24 .27 1"/>
      <geom type="cylinder" size=".035 .27" pos="-.70 -.20 -.27" rgba=".24 .24 .27 1"/>
    </body>

    <!--
      CUBES — small enough to fit between the gripper rubber tips
      (Stretch gripper X-tip-separation is ~24mm, so cubes must be <24mm wide)
      Half-size 0.010 = 20mm cubes, light mass and very high friction so the
      physics grip can actually hold them against gravity.
      Cube centre Z = 0.54 (conveyor top) + 0.010 (cube half) = 0.550
    -->
    <body name="cube_0" pos="3.475 -0.85 0.58">
      <freejoint/>
      <geom type="box" size=".040 .040 .040" mass=".4"
            material="cube_red"  friction="2.0 0.5 0.5"/>
    </body>
    <body name="cube_1" pos="3.625 -0.85 0.58">
      <freejoint/>
      <geom type="box" size=".040 .040 .040" mass=".4"
            material="cube_red"  friction="2.0 0.5 0.5"/>
    </body>
    <body name="cube_2" pos="3.775 -0.85 0.58">
      <freejoint/>
      <geom type="box" size=".040 .040 .040" mass=".4"
            material="cube_red"  friction="2.0 0.5 0.5"/>
    </body>
    <body name="cube_3" pos="3.925 -0.85 0.58">
      <freejoint/>
      <geom type="box" size=".040 .040 .040" mass=".4"
            material="cube_red"  friction="2.0 0.5 0.5"/>
    </body>
    <body name="cube_4" pos="4.075 -0.85 0.58">
      <freejoint/>
      <geom type="box" size=".040 .040 .040" mass=".4"
            material="cube_blue" friction="2.0 0.5 0.5"/>
    </body>
    <body name="cube_5" pos="4.225 -0.85 0.58">
      <freejoint/>
      <geom type="box" size=".040 .040 .040" mass=".4"
            material="cube_blue" friction="2.0 0.5 0.5"/>
    </body>
    <body name="cube_6" pos="4.375 -0.85 0.58">
      <freejoint/>
      <geom type="box" size=".040 .040 .040" mass=".4"
            material="cube_blue" friction="2.0 0.5 0.5"/>
    </body>
    <body name="cube_7" pos="4.525 -0.85 0.58">
      <freejoint/>
      <geom type="box" size=".040 .040 .040" mass=".4"
            material="cube_blue" friction="2.0 0.5 0.5"/>
    </body>

  </worldbody>
</mujoco>
